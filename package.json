{
  "name": "brief-report-builder",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "start": "node server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:macos": "scripts/build-macos.sh",
    "test:macos": "scripts/test-macos.sh",
    "lint:swift": "xcrun swift-format lint --strict --recursive macos scripts/testing",
    "format:swift": "xcrun swift-format format --in-place --recursive macos scripts/testing",
    "lint:python": "ruff check scripts/testing && ruff format --check scripts/testing",
    "lint:shell": "zsh -n scripts/build-macos.sh && zsh -n scripts/test-macos.sh",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "start:ai": "node --env-file=.env server/start.mjs",
    "eval:jev": "node --env-file=.env scripts/evaluate-jev.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0"
}
